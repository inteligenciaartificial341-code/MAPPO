rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ── Helpers ──────────────────────────────────────────────
       Autorização sempre via documento de membership (AD-2) --
       nunca via campo enviado pelo cliente (session.perfil etc). */
    function isRealAuth() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isMember(wsId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid));
    }
    function myRole(wsId) {
      return get(/databases/$(database)/documents/workspaces/$(wsId)/members/$(request.auth.uid)).data.role;
    }
    function isGestor(wsId) {
      return isMember(wsId) && myRole(wsId) == 'gestor';
    }
    /* Gate de aprovação manual (piloto privado): todo workspace novo nasce 'pendente'.
       Só o dono do projeto no Firebase Console aprova (edita fora das regras, via
       Console/Admin SDK -- não é uma operação de cliente). Sem isso, qualquer pessoa
       autenticada poderia se auto-cadastrar e usar dados sem curadoria nenhuma. */
    function isAtivo(wsId) {
      return get(/databases/$(database)/documents/workspaces/$(wsId)).data.status == 'ativo';
    }
    /* Auditoria de 2026-09-01: docIds sem nenhum caminho de escrita legítimo por
       técnico (verificado contra todo save*() e chamador em index.html) -- config,
       cadastro de cliente/manutenção, financeiro, vocabulário. mappo_os fica de fora
       de propósito: técnico precisa escrevê-la pra check-in/checklist/foto, e o
       blob JSON único (AD-8) não permite validação campo-a-campo na regra -- ver
       deferred-work.md pra essa pendência maior (fora do escopo desta correção). */
    function isGestorOnlyDoc(docId) {
      return docId in [
        'mappo_tecnicos','mappo_clientes','mappo_manut','mappo_settings',
        'mappo_checklist_config','mappo_preco_config','mappo_financeiro_notas',
        'mappo_vrf_fases_config','mappo_modulo_config','mappo_vrf_obras'
      ];
    }
    /* Blobs de posição MORTOS (2026-10-08). A posição de cada pessoa vive em
       workspaces/{ws}/live/{uid} desde 2026-09-27, e desde 2026-10-08 o app não APLICA mais
       data/mappo_locations nem data/mappo_live (saíram de SYNC_KEYS no index.html; o pull da
       coleção data/ continua baixando-os e os descarta em _ehChaveDeSync -- "não aplica" não
       é "não baixa", e o custo residual é de rede).
       Aqui a escrita é negada A TODOS -- não restringida a gestor. Restringir ao gestor
       ainda deixaria um caminho de escrita vivo num documento que ninguém lê: dado que
       entra e nunca sai é pior que erro, porque parece ter sido salvo. Não é gestor-only
       nem nunca foi: a razão é o caminho estar morto, não o papel de quem escreve.
       LEITURA continua permitida a membro: os dois documentos que já existem na nuvem NÃO
       foram apagados (dado histórico não se apaga sem decisão do proprietário), e negar a
       leitura não protegeria nada que a escrita negada já não proteja. */
    function isBlobPosicaoMorto(docId) {
      return docId in ['mappo_locations','mappo_live'];
    }
    /* Espelha só a parte de SEGURANÇA de _ramoCustomInvalido() (index.html) -- digitar uma
       chave herdada de Object.prototype (constructor, toString, etc.) como Ramo customizado
       fazia RAMO_TEMPLATES[ramo] resolver pra uma FUNÇÃO em vez de undefined, quebrando o
       fallback "||predial" -- só client-side até agora, uma escrita direta via SDK
       reintroduzia o bug. Não replica a checagem de nome reservado (refrigeracao/predial/
       outro colidir) aqui -- isso é regra de produto, não abre brecha de segurança nenhuma. */
    /* Convite dentro do prazo (2026-09-22). Até aqui o código valia PARA SEMPRE até ser
       usado ou revogado -- um print no WhatsApp ou um celular perdido continuava sendo uma
       chave viva do workspace meses depois. O cliente grava expiraEm = agora + 7 dias.
       Convite ANTIGO (sem o campo) continua valendo: são poucos, ficam visíveis na tela do
       gestor e podem ser revogados -- mesmo tratamento dado aos links públicos anteriores à
       expiração, e a alternativa (invalidar todos de uma vez) quebraria vínculos em
       andamento sem aviso. */
    function conviteNoPrazo(d) {
      return !('expiraEm' in d) || (d.expiraEm is number && d.expiraEm > request.time.toMillis());
    }
    function ramoValido(ramo) {
      return ramo is string && ramo.size() > 0 && ramo.size() <= 60 &&
        !(ramo.lower() in [
          'constructor','prototype','tostring','valueof',
          'hasownproperty','isprototypeof','propertyisenumerable','tolocalestring'
        ]);
    }

    /* ── Descoberta de workspace por uid (AD-11) ──────────────
       Só um ponteiro {workspaceId}; não concede acesso a dado
       nenhum por si só -- quem autoriza de fato é members/{uid}.
       Sem update: reatribuição de workspace não é modelada nesta
       espinha (assunção: uma pessoa pertence a 1 workspace).
       Delete (2026-09-01): sem isso, removerTecnico() só apagava
       members/{uid} e o ponteiro antigo ficava travado pra sempre
       (update:false) -- um técnico removido nunca mais conseguia
       ser convidado de novo, em NENHUMA empresa. Só o gestor do
       workspace que o ponteiro aponta agora pode apagá-lo -- nunca
       um uid arbitrário nem um gestor de outro workspace. */
    match /userWorkspaces/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if isRealAuth() && (
        request.auth.uid == uid ||
        isGestor(request.resource.data.workspaceId)
      );
      allow update: if false;
      allow delete: if isRealAuth() && isGestor(resource.data.workspaceId);
    }

    /* ── Metadado do workspace: só o marcador de bootstrap (AD-2) ──
       O predicado de bootstrap de members/{uid} abaixo depende da
       ausência deste documento -- por isso ele nunca é editável. */
    match /workspaces/{wsId} {
      allow read: if isMember(wsId);
      // status só pode nascer 'pendente' -- cliente nunca se auto-aprova; a aprovação
      // (pendente -> ativo) só acontece fora das regras (Console/Admin SDK do dono).
      allow create: if isRealAuth() && request.resource.data.criado == true
        && request.resource.data.status == 'pendente'
        && ramoValido(request.resource.data.ramo);
      allow update, delete: if false;
    }

    /* ── Membership: autorização por papel via get(), nunca por claim do cliente (AD-2) ── */
    match /workspaces/{wsId}/members/{uid} {
      allow read: if isMember(wsId);
      allow create: if isRealAuth() && (
        isGestor(wsId) ||
        ( // bootstrap do primeiro gestor: só antes do marcador do workspace existir
          request.auth.uid == uid &&
          request.resource.data.role == 'gestor' &&
          !exists(/databases/$(database)/documents/workspaces/$(wsId))
        ) ||
        ( // Story 11: auto-vínculo do prestador via convite de uso único, consumido na
          // mesma transação que atualiza convites/{codigo} (ver match abaixo). O uid só
          // cria o PRÓPRIO membership, como 'tecnico', citando um convite que ainda esteja
          // válido para ESTE workspace -- nunca um campo de perfil enviado livremente.
          request.auth.uid == uid &&
          request.resource.data.role == 'tecnico' &&
          get(/databases/$(database)/documents/convites/$(request.resource.data.convite)).data.workspaceId == wsId &&
          get(/databases/$(database)/documents/convites/$(request.resource.data.convite)).data.usado == false &&
          get(/databases/$(database)/documents/convites/$(request.resource.data.convite)).data.revogadoEm == null &&
          conviteNoPrazo(get(/databases/$(database)/documents/convites/$(request.resource.data.convite)).data)
        )
      );
      allow update: if isRealAuth() && isGestor(wsId);
      // gestor nunca remove o próprio membership (evita workspace órfão sem gestor)
      allow delete: if isRealAuth() && isGestor(wsId) && request.auth.uid != uid;
    }

    /* ── Convite de prestador (Story 11): vaga de técnico (tecnicos[] com uid:null)
       auto-vinculável por código de uso único -- o gestor gera pra uma vaga já criada,
       o próprio prestador troca nome+código pelo vínculo, sem o gestor colar UID manual.
       Coleção raiz, não workspaces/{wsId}/data/... -- o prestador não sabe o wsId até
       consumir o código (mesmo raciocínio de userWorkspaces/{uid}, AD-11).
       allow get (NUNCA allow read): bloqueia list/enumeração -- só quem já tem o
       código específico consegue ler aquele documento. */
    match /convites/{codigo} {
      allow get: if isRealAuth();
      /* expiraEm obrigatório e no futuro: sem isso um convite poderia nascer sem prazo
         (eterno de novo) ou já vencido. Sem teto máximo de propósito -- quem cria é o
         gestor, que já tem acesso total ao workspace; um teto só criaria falha de escrita
         legítima se o relógio do aparelho dele estivesse adiantado. */
      allow create: if isRealAuth() && isGestor(request.resource.data.workspaceId)
        && request.resource.data.usado == false
        && request.resource.data.revogadoEm == null
        && request.resource.data.expiraEm is number
        && request.resource.data.expiraEm > request.time.toMillis();
      allow update: if isRealAuth() && (
        ( // gestor revoga um convite ainda pendente (não desfaz vínculo já consumido)
          isGestor(resource.data.workspaceId) &&
          resource.data.usado == false && resource.data.revogadoEm == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revogadoEm']) &&
          request.resource.data.revogadoEm != null
        ) ||
        ( // o próprio prestador consome, na mesma transação que cria o members/{uid} dele
          resource.data.usado == false && resource.data.revogadoEm == null &&
          conviteNoPrazo(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usado','usadoPor','usadoEm']) &&
          request.resource.data.usado == true &&
          request.resource.data.usadoPor == request.auth.uid
        )
      );
      allow list, delete: if false;
    }

    /* ── Dados sincronizados do workspace (envelope {json,updatedAt,by}, AD-8) ──
       pub_{token} é o único documento lido sem membership -- é o link
       público do cliente (preserva o comportamento existente, FR-13); pub_* também
       exige workspace ativo, senão um link gerado durante a aprovação vazaria dado.
       pub_* também exige expiraEm no futuro (ou ausente -- link antigo, pré-story, nunca
       expira) -- revogar (Story 5) grava expiraEm=agora, mesmo mecanismo da expiração
       natural; só se aplica ao ramo público, membro sempre lê os próprios docs pub_.
       isGestorOnlyDoc() trava escrita de config/cadastro/financeiro/vocabulário a
       gestor -- essas telas já eram gestor-only na UI, agora também na regra
       (auditoria de 2026-09-01). mappo_os fica fora de propósito, ver a função.
       isBlobPosicaoMorto() nega a escrita de data/mappo_locations e data/mappo_live a
       QUALQUER UM (2026-10-08) -- é o que fecha o Bloco 2: enquanto esse blob fosse
       escrevível por qualquer membro, a posição de qualquer colega era falsificável.
       Membro de workspace pendente autentica e vê o próprio status (isMember, acima)
       mas não lê nem grava nenhum dado até o dono do projeto aprovar. */
    match /workspaces/{wsId}/data/{docId} {
      // resource==null cobre o GET de um pub_{token} que nunca existiu/foi digitado errado --
      // sem essa checagem, resource.data erraria na avaliação da regra (nega por erro), e um
      // link nunca-emitido virava "Link expirado" em vez do "Link não encontrado" correto.
      allow read: if request.auth != null && isAtivo(wsId) && (
        (docId.matches('pub_.*') && (resource==null || !('expiraEm' in resource.data) || resource.data.expiraEm > request.time.toMillis())) ||
        isMember(wsId)
      );
      // isBlobPosicaoMorto(docId) vem ANTES de tudo: nem gestor escreve num caminho morto.
      allow write: if isMember(wsId) && isAtivo(wsId) && !isBlobPosicaoMorto(docId)
        && (!isGestorOnlyDoc(docId) || isGestor(wsId));
    }

    /* ── Posição de cada pessoa: um documento por uid (2026-09-27) ──
       Até aqui a posição de TODO MUNDO vivia em dois blobs compartilhados
       (data/mappo_locations e data/mappo_live) e a regra de data/{docId} só exige ser
       membro: qualquer técnico podia gravar a posição de qualquer colega. É a prova de onde
       a pessoa esteve, e ela era falsificável. Aqui só o dono do uid escreve o documento
       dele -- request.auth.uid vem do token do Firebase Auth, não de campo enviado.

       O INVARIANTE DO NOME, dito com precisão: o documento SIM carrega um nome -- o campo
       'by' do envelope, que _gravarMesclado() estampa em toda escrita (index.html). O que
       segura a correção é o LEITOR: _nomeDoUid() resolve o nome só por mappo_tecnicos
       (t.uid === docId), que é gestor-only (isGestorOnlyDoc), e IGNORA 'by' por completo.
       'by' é diagnóstico. Se algum dia alguém renderizar a partir dele, um técnico passa a
       reivindicar o nome de outro e esta correção vira teatro.

       allow delete: if false -- nem o próprio dono apaga. Nenhum caminho do app apaga, e
       posição é prova de onde a pessoa esteve: deixar o dono apagar o próprio rastro é o
       mesmo tipo de buraco que deixar um colega falsificá-lo.
       isRealAuth() TAMBÉM na leitura: nenhum fluxo legítimo aqui é anônimo -- o link público
       do cliente lê data/pub_*, nunca este caminho.
       hasOnly + json is string: sem validar a forma, um membro grava campos arbitrários no
       próprio uid e todo colega baixa isso a cada boot (_pullPosicoes faz .get() da coleção
       inteira). Limita a FORMA, não o TAMANHO -- o teto por documento continua sendo só o
       1 MiB do Firestore, e isso está fixado como caso [GAP ACEITO] em teste-regras.js.
       Leitura por qualquer membro do workspace ativo: é o mapa da equipe, o mesmo alcance
       que o blob antigo já tinha. Não-membro e workspace pendente continuam de fora.

       Bloco ADITIVO: nenhuma linha anterior deste arquivo muda. O caminho não existia antes
       e o arquivo não tem catch-all, então até agora ele negava por omissão -- publicar
       esta regra ANTES do código novo não altera comportamento nenhum. */
    match /workspaces/{wsId}/live/{uid} {
      allow read: if isRealAuth() && isMember(wsId) && isAtivo(wsId);
      allow create, update: if isRealAuth() && isMember(wsId) && isAtivo(wsId)
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['json','updatedAt','by'])
        && request.resource.data.json is string;
      allow delete: if false;
    }

    /* ── Avaliação do app (Story 14, feedback do piloto) ──────
       Coleção raiz, fora de qualquer workspace -- write-only do lado do cliente:
       nenhum perfil (gestor/técnico) lê de volta, nem o próprio autor (Never do
       Intent: sem tela/painel de leitura dentro do app, sem conceito de admin
       client-side). Leitura só pelo dono do projeto, direto no Firebase Console
       ou Admin SDK, fora do alcance destas regras.
       isMember(workspaceId enviado) -- nunca um workspaceId arbitrário; qualquer
       papel serve (CAP-15 não restringe por perfil, só por ser membro real). */
    match /feedback/{id} {
      allow create: if isRealAuth()
        && isMember(request.resource.data.workspaceId)
        && request.resource.data.nota is number
        && request.resource.data.nota >= 1
        && request.resource.data.nota <= 5;
      allow read, update, delete: if false;
    }
  }
}

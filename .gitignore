__pycache__/
*.pyc
.pytest_cache/
node_modules/

# Capturas de tela geradas pelos diagnosticos em testes/ a cada execucao.
# Ancorados com "/" para casarem so na raiz: sem a barra, "etiq-*.png" e "mob-*.png"
# casariam em qualquer subpasta (existe uma pasta "logo app/" no repositorio).
# Nao usar "*.png": os icones e as telas de abertura do app na raiz sao versionados.
/diag-concluir.png
/linkreal.png
/etiq-*.png
/mob-*.png

# PDFs baixados pelas suites (teste-pdfos, teste-fotoidb) a cada execucao.
/testes/*.pdf

# Logs que o Firestore Emulator escreve na pasta onde roda (testes/teste-regras.js).
# Ancorados com "/" pelo mesmo motivo das capturas acima: casar so na raiz.
/firebase-debug.log
/firestore-debug.log
/ui-debug.log

# Planejamento, auditoria e configuracao de agentes: NAO entram no repositorio.
# Isto era disciplina ("nunca git add -A") e virou mecanismo em 10/10/2026, depois de
# medir que 213 arquivos nao rastreados estavam a um `git add -A` de serem publicados --
# entre eles a auditoria de seguranca do app, que esta no ar com dados reais de cliente.
# O acidente ja aconteceu uma vez (22 documentos varridos para dentro de um commit).
# Ignorar NAO despublica o que ja foi commitado antes disto; so impede que cresca.
_bmad-output/
_audit/
.agents/
.claude/skills/
skills-lock.json
.vscode/

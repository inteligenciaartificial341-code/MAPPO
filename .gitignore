__pycache__/
*.pyc
.pytest_cache/
node_modules/

# Capturas de tela geradas pelos diagnosticos em testes/ a cada execucao.
# Ancorados com "/" para casarem so na raiz: sem a barra, "etiq-*.png" e "mob-*.png"
# casariam em qualquer subpasta (existe uma pasta "logo app/" no repositorio).
# Nao usar "*.png": os icones e as telas de abertura do app na raiz sao versionados.
/diag-concluir.png
/linkreal.png
/etiq-*.png
/mob-*.png

# PDFs baixados pelas suites (teste-pdfos, teste-fotoidb) a cada execucao.
/testes/*.pdf

# Logs que o Firestore Emulator escreve na pasta onde roda (testes/teste-regras.js).
# Ancorados com "/" pelo mesmo motivo das capturas acima: casar so na raiz.
/firebase-debug.log
/firestore-debug.log
/ui-debug.log
